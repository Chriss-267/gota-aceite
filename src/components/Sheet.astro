---
import Icon from './Icon.astro';
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<dialog id={id} class="sheet">
  <div class="sticky top-0 bg-white z-10 px-5 pt-3 pb-3">
    <div class="mx-auto w-10 h-1.5 rounded-full bg-plum-100 mb-3"></div>
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-extrabold text-plum-950">{title}</h2>
      <button type="button" data-close class="grid place-items-center w-9 h-9 rounded-full bg-plum-50 text-plum-900" aria-label="Cerrar">
        <Icon name="x" />
      </button>
    </div>
  </div>
  <div class="px-5 pb-6">
    <slot />
  </div>
</dialog>
